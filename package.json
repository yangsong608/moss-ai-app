{
  "name": "moss-ai-app",
  "version": "0.1.0",
  "private": true,
  "description": "MOSS AI App — 移动端产品（自 dsh-link-suite/app 独立）：当前含 DSH Link 远程模块，可持续加入新功能",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:protocol": "npm --prefix protocol run typecheck",
    "test:protocol": "npm --prefix protocol run test",
    "test:sync": "node scripts/sync-adapter-test.mjs",
    "test:ai-dispatch": "node scripts/ai-dispatch-test.mjs",
    "test:ai-context": "node scripts/ai-context-test.mjs",
    "check": "npm run typecheck && npm run test:protocol && npm run test:sync && npm run test:ai-dispatch && npm run test:ai-context && npm run build:h5 && npm run smoke",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@types/node": "^22.20.5",
    "sass": "^1.77.0",
    "typescript": "^5.6.3",
    "vite": "^5.2.8",
    "vue-tsc": "^2.1.6"
  }
}